{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["environment.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Distinguishes `{ foo: undefined }` from an omitted `foo` on optional
    // properties, so an agent can't silently smuggle `undefined` in.
    "exactOptionalPropertyTypes": true,
    // Every code path in a function must return (or none may) - catches
    // accidentally-missing `return`s in edited branches.
    "noImplicitReturns": true,
    // Requires an explicit `break`/`return`/`throw` in switch cases.
    "noFallthroughCasesInSwitch": true,
    // Forces bracket notation for index-signature access, so typos in
    // dynamic property names surface as type errors instead of `any`.
    "noPropertyAccessFromIndexSignature": true,

    // Path mapping for cleaner imports.
    "paths": {
      "@/*": ["./src/*"]
    },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
